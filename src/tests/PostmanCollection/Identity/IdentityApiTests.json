{
  "info": {
    "_postman_id": "36caab54-2af6-42bb-9ea1-7bdc22c00ca4",
    "name": "GymTracker Identity API",
    "description": "Tests for the Identity API: Register, Login, Refresh Token",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "3248614"
  },
  "item": [
    {
      "name": "Register",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response has token, refreshToken and userId', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json).to.have.property('token');",
              "    pm.expect(json).to.have.property('refreshToken');",
              "    pm.expect(json).to.have.property('userId');",
              "    pm.expect(json.token).to.be.a('string').and.not.empty;",
              "    pm.expect(json.refreshToken).to.be.a('string').and.not.empty;",
              "});",
              "",
              "var json = pm.response.json();",
              "pm.environment.set('token', json.token);",
              "pm.environment.set('refreshToken', json.refreshToken);",
              "pm.environment.set('userId', json.userId);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "var email = pm.variables.replaceIn('{{$randomEmail}}');\r",
              "var password = pm.variables.replaceIn('{{$randomPassword}}');\r",
              "\r",
              "pm.collectionVariables.set(\"testEmail\", email);\r",
              "pm.collectionVariables.set(\"testPassword\", password);\r",
              "\r",
              "console.log('email :'+email);\r",
              "console.log('password :'+password);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"confirmPassword\": \"{{testPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Login",
