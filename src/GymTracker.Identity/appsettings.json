{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "IdentityConnection": "Server=(localdb)\\mssqllocaldb;Database=GymTracker.Identity;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "JwtSettings": {
    "Secret": "CHANGE_ME_TO_A_SECURE_SECRET_AT_LEAST_32_CHARS",
    "Issuer": "GymTracker.Identity",
    "Audience": "GymTracker.Api",
    "ExpiresInMinutes": "60"
  }
}
